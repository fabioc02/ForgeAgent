      "source": [
        "# 🔥 ForgeAgent - AI Software Forge\n",
        "Execute esta unica celula para iniciar o agente.\n",
        "\n",
        "**Requisitos:**\n",
        "- GPU T4 (Runtime > Change runtime type > T4 GPU)\n",
        "- Ngrok Auth Token (obtenha em https://dashboard.ngrok.com/get-started/your-authtoken)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell-unified"
      },
      "outputs": [],
      "source": [
        "# ============================================\n",
        "# CONFIGURACOES (PREENCHA ANTES DE EXECUTAR)\n",
        "# ============================================\n",
        "NGROK_TOKEN = \"\"  # @param {type:\"string\"}\n",
        "GITHUB_REPO = \"\"  # @param {type:\"string\"} (ex: seu-usuario/ForgeAgent)\n",
        "\n",
        "import os\n",
        "import sys\n",
        "import subprocess\n",
        "import time\n",
        "from google.colab import drive\n",
        "\n",
        "# Configurar Ngrok\n",
        "if NGROK_TOKEN:\n",
        "    os.environ[\"NGROK_AUTHTOKEN\"] = NGROK_TOKEN\n",
        "\n",
        "# ============================================\n",
        "# 1. CONECTAR GOOGLE DRIVE\n",
        "# ============================================\n",
        "print(\"=== Conectando Google Drive ===\")\n",
        "drive.mount('/content/drive')\n",
        "DRIVE_AGENT_DIR = \"/content/drive/MyDrive/ForgeAgent/Drive\"\n",
        "os.makedirs(DRIVE_AGENT_DIR, exist_ok=True)\n",
        "print(\"[OK] Drive conectado em:\" + DRIVE_AGENT_DIR)\n",
        "\n",
        "# ============================================\n",
        "# 2. CLONAR REPOSITORIO\n",
        "# ============================================\n",
        "print(\"\\n=== Clonando repositorio ===\")\n",
        "os.chdir('/content')\n",
        "\n",
        "if GITHUB_REPO:\n",
        "    REPO_URL = \"https://github.com/\" + GITHUB_REPO\n",
        "    os.system('rm -rf /content/ForgeAgent')\n",
        "    os.system('git clone ' + REPO_URL + ' /content/ForgeAgent')\n",
        "else:\n",
        "    print(\"[AVISO] GITHUB_REPO nao configurado. Usando diretorio local.\" )\n",
        "    print(\"[DICA] Faca push do codigo para o GitHub primeiro.\" )\n",
        "    if not os.path.exists('/content/ForgeAgent'):\n",
        "        os.makedirs('/content/ForgeAgent', exist_ok=True)\n",
        "\n",
        "os.chdir('/content/ForgeAgent')\n",
        "print(\"[OK] Repositorio em: /content/ForgeAgent\")\n",
        "\n",
        "# ============================================\n",
        "# 3. SINCRONIZAR DRIVE\n",
        "# ============================================\n",
        "print(\"\\n=== Sincronizando Drive ===\")\n",
        "os.system('cp -rn /content/ForgeAgent/Drive/* ' + DRIVE_AGENT_DIR + '/ 2>/dev/null')\n",
        "os.system('rm -rf /content/ForgeAgent/Drive')\n",
        "os.system('ln -s ' + DRIVE_AGENT_DIR + ' /content/ForgeAgent/Drive')\n",
        "print(\"[OK] Drive sincronizado\")\n",
        "\n",
        "# ============================================\n",
        "# 4. INSTALAR DEPENDENCIAS\n",
        "# ============================================\n",
        "print(\"\\n=== Instalando dependencias ===\")\n",
        "print(\"Isso pode demorar 2-3 minutos...\")\n",
        "\n",
        "# Node.js\n",
        "os.system('curl -fsSL https://deb.nodesource.com/setup_20.x | bash - > /dev/null 2>&1')\n",
        "os.system('apt-get install -y nodejs > /dev/null 2>&1')\n",
        "print(\"[OK] Node.js instalado\")\n",
        "\n",
        "# Python\n",
        "os.system(sys.executable + ' -m pip install -q -r requirements.txt pyngrok > /dev/null 2>&1')\n",
        "print(\"[OK] Python dependencies instaladas\")\n",
        "\n",
        "# vLLM (se GPU disponivel)\n",
        "import torch\n",
        "if torch.cuda.is_available():\n",
        "    print(\"[INFO] GPU detectada: " + torch.cuda.get_device_name(0))\n",
        "    print(\"[INFO] Instalando vLLM para inferencia rapida...\")\n",
        "    os.system(sys.executable + ' -m pip install -q vllm > /dev/null 2>&1')\n",
        "    print(\"[OK] vLLM instalado\")\n",
        "else:\n",
        "    print(\"[AVISO] GPU nao detectada. Usando modo CPU (mais lento).\")\n",
        "\n",
        "# npm\n",
        "os.system('npm install --silent > /dev/null 2>&1')\n",
        "print(\"[OK] npm packages instaladas\")\n",
        "\n",
        "# ============================================\n",
        "# 5. MATAR PROCESSOS ANTIGOS\n",
        "# ============================================\n",
        "os.system('lsof -ti:3000 | xargs kill -9 2>/dev/null')\n",
        "os.system('lsof -ti:8000 | xargs kill -9 2>/dev/null')\n",
        "os.system('pkill -f ngrok')\n",
        "\n",
        "# ============================================\n",
        "# 6. INICIAR SERVIDORES\n",
        "# ============================================\n",
        "print(\"\\n=== Iniciando servidores ===\")\n",
        "env = os.environ.copy()\n",
        "env['PYTHON_EXEC'] = sys.executable\n",
        "\n",
        "# Backend (FastAPI)\n",
        "backend_log = open('/content/ForgeAgent/backend.log', 'w')\n",
        "subprocess.Popen(\n",
        "    [sys.executable, \"server/main.py\"],\n",
        "    cwd=\"/content/ForgeAgent\",\n",
        "    env=env,\n",
        "    stdout=backend_log,\n",
        "    stderr=subprocess.STDOUT\n",
        ")\n",
        "print(\"[OK] Backend iniciado (porta 8000)\")\n",
        "\n",
        "time.sleep(10)\n",
        "\n",
        "# Frontend (Vite)\n",
        "frontend_log = open('/content/ForgeAgent/frontend.log', 'w')\n",
        "subprocess.Popen(\n",
        "    [\"npm\", \"run\", \"dev\"],\n",
        "    cwd=\"/content/ForgeAgent\",\n",
        "    env=env,\n",
        "    stdout=frontend_log,\n",
        "    stderr=subprocess.STDOUT\n",
        ")\n",
        "print(\"[OK] Frontend iniciado (porta 3000)\")\n",
        "\n",
        "time.sleep(5)\n",
        "\n",
        "# ============================================\n",
        "# 7. EXPOR VIA NGROK\n",
        "# ============================================\n",
        "if not NGROK_TOKEN:\n",
        "    print(\"\\n[ERRO] NGROK_TOKEN nao configurado!\")\n",
        "    print(\"Obtenha seu token em: https://dashboard.ngrok.com/get-started/your-authtoken\")\n",
        "else:\n",
        "    print(\"\\n=== Expondo via Ngrok ===\")\n",
        "    from pyngrok import ngrok\n",
        "    ngrok.set_auth_token(NGROK_TOKEN)\n",
        "    \n",
        "    public_url = ngrok.connect(3000).public_url\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"🔥 ACESSE SEU FORGEAGENT:\")\n",
        "    print(\"👉  \" + public_url + \"  👈\")\n",
        "    print(\"=\"*60 + \"\\n\")\n",
        "    print(\"O agente esta rodando com GPU T4 (Qwen2.5-Coder-7B)\")\n",
        "    print(\"Tudo sera salvo automaticamente no Google Drive\")\n",
        "\n",
        "# ============================================\n",
        "# 8. MOSTRAR LOGS\n",
        "# ============================================\n",
        "time.sleep(2)\n",
        "print(\"\\n=== Logs do Backend ===\")\n",
        "os.system('tail -n 20 /content/ForgeAgent/backend.log')\n",
        "\n",
        "print(\"\\n=== Logs do Frontend ===\")\n",
        "os.system('tail -n 10 /content/ForgeAgent/frontend.log')\n",
        "\n",
        "print(\"\\n[OK] ForgeAgent pronto! Acesse o link acima.\")\n",
        "print(\"[DICA] Para ver logs em tempo real:\")\n",
        "print(\"  !tail -f /content/ForgeAgent/backend.log\")\n",
        "print(\"  !tail -f /content/ForgeAgent/frontend.log\")\n",
        "\n",
        "# Manter celula rodando\n",
        "print(\"\\n[Celula mantida ativa. Pressione Stop para encerrar.]\")\n",
        "while True:\n",
        "    time.sleep(60)\n"
      ]
    }
  ]
